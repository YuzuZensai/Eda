{
  "name": "eda",
  "version": "0.0.1",
  "description": "A modern, open source Git client",
  "license": "GPL-3.0-or-later",
  "author": "Yuzu <yuzu@kirameki.cafe>",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tooling.json",
    "lint": "eslint src scripts tests *.ts --max-warnings 0",
    "test": "node --test tests/tooling/*.test.ts && vitest run",
    "test:desktop": "node tests/desktop/run.ts",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\" \"{scripts,tests}/**/*.{ts,tsx,json}\" \"*.{js,mjs,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\" \"{scripts,tests}/**/*.{ts,tsx,json}\" \"*.{js,mjs,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "package": "pnpm build && electron-builder --config electron-builder.config.ts",
    "screenshot": "pnpm build && node scripts/screenshot.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "colorjs.io": "^0.7.1",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "i18next": "^26.5.11",
    "jiti": "^2.7.0",
    "lucide-react": "^1.64.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
